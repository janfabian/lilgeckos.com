# Server
PORT=8137
LOG_LEVEL=info

# Auth for POST /publish — any long random secret. Callers send: Authorization: Bearer <HUB_TOKEN>
HUB_TOKEN=

# Twitter / X — OAuth 1.0a user context. Tokens MUST have Read+Write permission.
# From developer.x.com -> your App -> Keys and tokens.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional: enable the no-cost mock adapter (target "mock") for local testing.
MOCK_ENABLED=

# Optional: max image file size in bytes (default 15728640 = 15MB).
MEDIA_MAX_BYTES=
# Optional: max video file size in bytes (default 536870912 = 512MB).
MEDIA_VIDEO_MAX_BYTES=

# Facebook Page (Meta Graph API). Long-lived Page access token + the Page's numeric id.
# Get both with: bun run auth:facebook  (writes these two for the Page you pick).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: Graph API version (default v21.0).
FACEBOOK_GRAPH_VERSION=
# Only needed by `bun run auth:facebook` (not at runtime): your Meta app's
# App ID + Secret (developers.facebook.com → your app → Settings → Basic).
# Add http://localhost:4181/ to the app's Facebook Login "Valid OAuth Redirect URIs".
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram (Graph API via Facebook Login). The IG Business account id linked to
# the Page; publishing reuses FACEBOOK_PAGE_ACCESS_TOKEN. `bun run auth:facebook`
# auto-detects and writes this once the app has instagram_basic +
# instagram_content_publish permissions. IG ingests media by public URL, so it
# reuses the blog's GitHub repo (BLOG_* below) to host media.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Blog (Astro site in site/, published to GitHub Pages). The adapter commits a
# markdown post via the GitHub Contents API; the commit triggers the deploy.
# Token: a FINE-GRAINED PAT scoped to the blog repo with Contents: read & write
# ONLY (it intentionally cannot edit .github/workflows). Both token + repo
# required to enable the adapter.
BLOG_GITHUB_TOKEN=
BLOG_REPO=janfabian/lilgeckos.com
# Optional: branch to commit to (default main), content dir, and public site URL.
BLOG_BRANCH=
BLOG_CONTENT_DIR=
# Set to https://lilgeckos.com once the custom domain is live (default is the
# project-pages URL). Used to build post permalinks.
BLOG_SITE_URL=

# --- Level-2 subscriber (WhatsApp -> LLM parse -> propose -> publish) ---
# Comma-separated chat JIDs the subscriber watches (e.g. the lilgeckos group).
SUBSCRIBER_CHATS=
# Long-lived Claude Code OAuth token from `claude setup-token` — lets the LLM
# parse step bill your Claude subscription instead of API credits. Do NOT also
# set ANTHROPIC_API_KEY (it takes precedence and bills credits).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides (defaults shown):
# HUB_URL=http://127.0.0.1:8137
# BRIDGE_WS_URL=ws://127.0.0.1:8080/ws/events
# BRIDGE_HTTP_URL=http://127.0.0.1:8080

# YouTube (Data API v3, uploads as Shorts). OAuth2 — see README/key writeup.
# client id+secret from a Google Cloud OAuth client; refresh token from `bun run auth:youtube`.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional: public | unlisted | private (default public).
YOUTUBE_PRIVACY=

# Reddit (OAuth — web app from reddit.com/prefs/apps, redirect_uri exactly
# http://localhost:4182/). `bun run auth:reddit` mints the refresh token and
# auto-captures the username. Default subreddit is the user's own profile sub
# (u_<username>) — always safe. Set REDDIT_SUBREDDIT to override (e.g.
# "leopardgeckos" for r/leopardgeckos — mind the community's self-promo rules).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USERNAME=
REDDIT_SUBREDDIT=
