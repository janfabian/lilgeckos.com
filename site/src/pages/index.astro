---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const latest = all.slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { dateStyle: 'medium' });
---

<BaseLayout title="lilgeckos.com" description="A running journal of life with leopard geckos.">
  <section class="intro">
    <h1>Little geckos, big internet.</h1>
    <p class="lede">
      A running journal of life with leopard geckos — new arrivals, sheds, feeding notes, and the
      occasional very important water break.
    </p>
  </section>

  <section class="feed">
    <div class="feed-head">
      <h1>Latest</h1>
      <span class="count">{all.length} {all.length === 1 ? 'post' : 'posts'}</span>
    </div>
    {latest.length === 0 && <p class="crumbs-meta">No posts yet — check back soon.</p>}
    <ul class="post-list">
      {
        latest.map((post) => (
          <li>
            <a class="entry" href={`${base}/blog/${post.id}`}>
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              <span class="ttl">{post.data.title}</span>
              {post.data.description && <span class="desc">{post.data.description}</span>}
            </a>
          </li>
        ))
      }
    </ul>
    {all.length > latest.length && <a class="more-link" href={`${base}/blog`}>All posts →</a>}
  </section>

  <style>
    .intro { margin-bottom: 56px; }
    .intro h1 {
      margin: 0 0 14px;
      font-size: 34px;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }
    .intro .lede {
      margin: 0;
      font-size: 17px;
      color: var(--ink-soft);
      line-height: 1.6;
      max-width: 52ch;
    }
    .more-link {
      display: inline-block;
      margin-top: 30px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.02em;
      color: var(--ink-soft);
      text-decoration: none;
    }
    .more-link:hover { color: var(--ink); }
  </style>
</BaseLayout>
