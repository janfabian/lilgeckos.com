---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostEntry from '../../components/PostEntry.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout title="Journal — lilgeckos.com" description="Notes, photos and clips from lilgeckos.">
  <section class="feed">
    <div class="feed-head">
      <h1>Journal</h1>
      <span class="count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
    </div>
    {posts.length === 0 && <p class="crumbs-meta">No posts yet.</p>}
    <ul class="post-list">
      {posts.map((post) => <PostEntry post={post} base={base} />)}
    </ul>
  </section>
</BaseLayout>
