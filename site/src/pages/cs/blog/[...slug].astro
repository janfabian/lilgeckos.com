---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { STRINGS, localized } from '../../../lib/i18n';
const lang = 'cs' as const;
const t = STRINGS[lang];
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'cs')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.data.translationKey },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (d: Date) => d.toLocaleDateString('cs-CZ', { dateStyle: 'medium' });
const key = post.data.translationKey;
const blogBase = `${base}${localized(lang, '/blog')}`;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://lilgeckos.com').href;
---
<BaseLayout title={`${post.data.title} — lilgeckos.com`} description={post.data.description} lang={lang} switchHref={`${localized('en', '/blog')}/${key}`}>
  <nav class="crumbs">
    <a href={blogBase}>{t.allPosts}</a>
    <span class="crumbs-meta">{key}</span>
  </nav>
  <article class="post post-solo">
    <div class="post-head">
      <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
      <span class="kind">deník</span>
    </div>
    <h1 class="ttl">{post.data.title}</h1>
    <div class="post-body"><Content /></div>
    <ShareButtons url={pageUrl} title={post.data.title} lang={lang} />
  </article>
  {(newer || older) && (
    <nav class="adjacent">
      <div class="side">
        {newer ? (
          <a href={`${blogBase}/${newer.data.translationKey}`}>
            <span class="dir">{t.newer}</span><span class="ttl">{newer.data.title}</span>
            <span class="d">{fmt(newer.data.pubDate)}</span>
          </a>
        ) : <span class="empty">{t.emptyNewer}</span>}
      </div>
      <div class="side r">
        {older ? (
          <a href={`${blogBase}/${older.data.translationKey}`}>
            <span class="dir">{t.older}</span><span class="ttl">{older.data.title}</span>
            <span class="d">{fmt(older.data.pubDate)}</span>
          </a>
        ) : <span class="empty">{t.emptyOlder}</span>}
      </div>
    </nav>
  )}
</BaseLayout>
